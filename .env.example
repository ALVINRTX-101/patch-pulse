# Runtime
PATCH_PULSE_DRY_RUN=true
PATCH_PULSE_LOG_LEVEL=INFO
PATCH_PULSE_AUDIT_FILE=./audit/patch-pulse-audit.jsonl
PATCH_PULSE_ALLOWED_ENVIRONMENTS=dev,staging
PATCH_PULSE_ALLOW_PRODUCTION=false
PATCH_PULSE_ANSIBLE_TIMEOUT=1800
PATCH_PULSE_RETRY_ATTEMPTS=3
PATCH_PULSE_RETRY_BACKOFF=2

# Jira
JIRA_BASE_URL=https://jira.example.com
JIRA_API_TOKEN=
JIRA_USER_EMAIL=
JIRA_PROJECT_KEY=SEC
JIRA_STANDARD_CHANGE_ISSUE_TYPE=Change
JIRA_VERIFY_STATUS_NAMES=Approved,Open,In Progress

# Optional CAB integration
CAB_APPROVAL_REQUIRED=true
CAB_APPROVAL_URL=
CAB_API_TOKEN=

# Optional remediation API
REMEDIATION_API_URL=
REMEDIATION_API_TOKEN=
